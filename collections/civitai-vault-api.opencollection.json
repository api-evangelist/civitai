{
  "opencollection": "1.0.0",
  "info": {
    "name": "Civitai Orchestration Blobs Vault API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Vault",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Vault Item",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://orchestration.civitai.com/vault/get",
            "params": [
              {
                "name": "modelVersionId",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Vault Item"
        },
        {
          "info": {
            "name": "Get All Vault Items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://orchestration.civitai.com/vault/all",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get All Vault Items"
        },
        {
          "info": {
            "name": "Check Vault Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://orchestration.civitai.com/vault/check-vault",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Check Vault Status"
        },
        {
          "info": {
            "name": "Toggle Vault Version",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://orchestration.civitai.com/vault/toggle-version",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Toggle Vault Version"
        }
      ]
    }
  ],
  "bundled": true
}
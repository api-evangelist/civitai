{
  "opencollection": "1.0.0",
  "info": {
    "name": "Civitai Orchestration Blobs Models API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://orchestration.civitai.com/models",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "query",
                "value": "",
                "type": "query"
              },
              {
                "name": "tag",
                "value": "",
                "type": "query"
              },
              {
                "name": "username",
                "value": "",
                "type": "query"
              },
              {
                "name": "types",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "period",
                "value": "",
                "type": "query"
              },
              {
                "name": "nsfw",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List Models"
        },
        {
          "info": {
            "name": "Get Model",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://orchestration.civitai.com/models/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Model"
        }
      ]
    }
  ],
  "bundled": true
}